[
  {
    "id": "SHLOKA_000001",
    "text": "ज्योतिषां ज्योतिरजरं तदादित्यस्तपति।",
    "source": "atharvaveda_sample",
    "chapter": "",
    "veda": "Atharvaveda",
    "domain": "Astronomy",
    "branch": "Jyotisha",
    "keywords": [
      "astronomy",
      "atharvaveda",
      "jyotisha"
    ]
  },
  {
    "id": "SHLOKA_000002",
    "text": "सूर्यो ग्रहाणां राजा।।",
    "source": "atharvaveda_sample",
    "chapter": "",
    "veda": "Atharvaveda",
    "domain": "Astronomy",
    "branch": "Jyotisha",
    "keywords": [
      "astronomy",
      "atharvaveda",
      "jyotisha"
    ]
  },
  {
    "id": "SHLOKA_000003",
    "text": "चन्द्रमा नक्षत्राणां पतिः शीतलप्रकाशः।",
    "source": "atharvaveda_sample",
    "chapter": "",
    "veda": "Atharvaveda",
    "domain": "Astronomy",
    "branch": "Jyotisha",
    "keywords": [
      "astronomy",
      "atharvaveda",
      "jyotisha"
    ]
  },
  {
    "id": "SHLOKA_000004",
    "text": "रात्रौ प्रकाशयति।।",
    "source": "atharvaveda_sample",
    "chapter": "",
    "veda": "Atharvaveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "atharvaveda"
    ]
  },
  {
    "id": "SHLOKA_000005",
    "text": "ग्रहाः नवसंख्याकाः सूर्यमण्डलं परिक्रामन्ति।",
    "source": "atharvaveda_sample",
    "chapter": "",
    "veda": "Atharvaveda",
    "domain": "Mathematics",
    "branch": "Arithmetic",
    "keywords": [
      "mathematics",
      "atharvaveda",
      "arithmetic"
    ]
  },
  {
    "id": "SHLOKA_000006",
    "text": "ज्योतिष्यम्।।",
    "source": "atharvaveda_sample",
    "chapter": "",
    "veda": "Atharvaveda",
    "domain": "Astronomy",
    "branch": "Jyotisha",
    "keywords": [
      "astronomy",
      "atharvaveda",
      "jyotisha"
    ]
  },
  {
    "id": "SHLOKA_000007",
    "text": "नक्षत्राणि सप्तविंशतिः चन्द्रमण्डलं परिक्रामन्ति।।",
    "source": "atharvaveda_sample",
    "chapter": "",
    "veda": "Atharvaveda",
    "domain": "Astronomy",
    "branch": "Jyotisha",
    "keywords": [
      "astronomy",
      "atharvaveda",
      "jyotisha"
    ]
  },
  {
    "id": "SHLOKA_000008",
    "text": "अग्निमीळे पुरोहितं यज्ञस्य देवमृत्विजम्।",
    "source": "rigveda_mandala1",
    "chapter": "",
    "veda": "Rigveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "rigveda"
    ]
  },
  {
    "id": "SHLOKA_000009",
    "text": "होतारं रत्नधातमम्।।",
    "source": "rigveda_mandala1",
    "chapter": "",
    "veda": "Rigveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "rigveda"
    ]
  },
  {
    "id": "SHLOKA_000010",
    "text": "अग्निः पूर्वेभिरृषिभिरीड्यो नूतनैरुत।",
    "source": "rigveda_mandala1",
    "chapter": "",
    "veda": "Rigveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "rigveda"
    ]
  },
  {
    "id": "SHLOKA_000011",
    "text": "स देवाँ एह वक्षति।।",
    "source": "rigveda_mandala1",
    "chapter": "",
    "veda": "Rigveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "rigveda"
    ]
  },
  {
    "id": "SHLOKA_000012",
    "text": "अग्निना रयिमश्नवत् पोषमेव दिवेदिवे।",
    "source": "rigveda_mandala1",
    "chapter": "",
    "veda": "Rigveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "rigveda"
    ]
  },
  {
    "id": "SHLOKA_000013",
    "text": "यशसं वीरवत्तमम्।।",
    "source": "rigveda_mandala1",
    "chapter": "",
    "veda": "Rigveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "rigveda"
    ]
  },
  {
    "id": "SHLOKA_000014",
    "text": "अग्ने यं यज्ञमध्वरं विश्वतः परिभूरसि।",
    "source": "rigveda_mandala1",
    "chapter": "",
    "veda": "Rigveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "rigveda"
    ]
  },
  {
    "id": "SHLOKA_000015",
    "text": "स इद्देवेषु गच्छति।।",
    "source": "rigveda_mandala1",
    "chapter": "",
    "veda": "Rigveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "rigveda"
    ]
  },
  {
    "id": "SHLOKA_000016",
    "text": "अग्निर्होता कविक्रतुः सत्यश्चित्रश्रवस्तमः।",
    "source": "rigveda_mandala1",
    "chapter": "",
    "veda": "Rigveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "rigveda"
    ]
  },
  {
    "id": "SHLOKA_000017",
    "text": "देवो देवेभिरागमत्।।",
    "source": "rigveda_mandala1",
    "chapter": "",
    "veda": "Rigveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "rigveda"
    ]
  },
  {
    "id": "SHLOKA_000018",
    "text": "इन्द्रमिद् गाथिनो बृहदिन्द्रमर्केभिरर्किणः।",
    "source": "rigveda_mandala2",
    "chapter": "",
    "veda": "Rigveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "rigveda"
    ]
  },
  {
    "id": "SHLOKA_000019",
    "text": "इन्द्रं वाणीरनूषत।।",
    "source": "rigveda_mandala2",
    "chapter": "",
    "veda": "Rigveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "rigveda"
    ]
  },
  {
    "id": "SHLOKA_000020",
    "text": "इन्द्र इद्धर्योः सचा समिश्ल आ वचोयुजा।",
    "source": "rigveda_mandala2",
    "chapter": "",
    "veda": "Rigveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "rigveda"
    ]
  },
  {
    "id": "SHLOKA_000021",
    "text": "इन्द्रो वज्री हिरण्ययः।।",
    "source": "rigveda_mandala2",
    "chapter": "",
    "veda": "Rigveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "rigveda"
    ]
  },
  {
    "id": "SHLOKA_000022",
    "text": "इन्द्र इद्वृत्रहा वसु दाता मघवा पुरुहूतः।",
    "source": "rigveda_mandala2",
    "chapter": "",
    "veda": "Rigveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "rigveda"
    ]
  },
  {
    "id": "SHLOKA_000023",
    "text": "इन्द्रः सोमस्य पीतये।।",
    "source": "rigveda_mandala2",
    "chapter": "",
    "veda": "Rigveda",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": [
      "rigveda"
    ]
  },
  {
    "id": "SHLOKA_000024",
    "text": "समचतुरश्रस्य क्षेत्रफलं भुजवर्गः।।",
    "source": "sulbasutras_sample",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Mathematics",
    "branch": "Arithmetic",
    "keywords": [
      "mathematics",
      "arithmetic"
    ]
  },
  {
    "id": "SHLOKA_000025",
    "text": "आयतचतुरश्रस्य क्षेत्रफलं दीर्घभुजेन ह्रस्वभुजगुणितम्।।",
    "source": "sulbasutras_sample",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Mathematics",
    "branch": "Arithmetic",
    "keywords": [
      "mathematics",
      "arithmetic"
    ]
  },
  {
    "id": "SHLOKA_000026",
    "text": "त्रिभुजस्य क्षेत्रफलं भूमिश्चशीर्षलम्बार्धगुणितम्।।",
    "source": "sulbasutras_sample",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Mathematics",
    "branch": "Arithmetic",
    "keywords": [
      "mathematics",
      "arithmetic"
    ]
  },
  {
    "id": "SHLOKA_000027",
    "text": "वृत्तस्य क्षेत्रफलं व्यासार्धवर्गं पाईगुणितम्।।",
    "source": "sulbasutras_sample",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Mathematics",
    "branch": "Arithmetic",
    "keywords": [
      "mathematics",
      "arithmetic"
    ]
  },
  {
    "id": "SHLOKA_000028",
    "text": "गोलस्य पृष्ठफलं व्यासवर्गं पाईगुणितम्।।",
    "source": "sulbasutras_sample",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Mathematics",
    "branch": "Arithmetic",
    "keywords": [
      "mathematics",
      "arithmetic"
    ]
  },
  {
    "id": "SHLOKA_000029",
    "text": "एकाधिकेन पूर्वेण।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": []
  },
  {
    "id": "SHLOKA_000030",
    "text": "इति सूत्रम्।।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Grammar",
    "branch": "Vyakarana",
    "keywords": [
      "grammar",
      "vyakarana"
    ]
  },
  {
    "id": "SHLOKA_000031",
    "text": "निखिलं नवतश्चरमं दशतः।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": []
  },
  {
    "id": "SHLOKA_000032",
    "text": "गणितसूत्रम्।।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Mathematics",
    "branch": "Arithmetic",
    "keywords": [
      "mathematics",
      "arithmetic"
    ]
  },
  {
    "id": "SHLOKA_000033",
    "text": "ऊर्ध्वतिर्यग्भ्याम्।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": []
  },
  {
    "id": "SHLOKA_000034",
    "text": "वर्गणासूत्रम्।।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Mathematics",
    "branch": "Arithmetic",
    "keywords": [
      "mathematics",
      "arithmetic"
    ]
  },
  {
    "id": "SHLOKA_000035",
    "text": "परावर्त्य योजयेत्।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": []
  },
  {
    "id": "SHLOKA_000036",
    "text": "भागसूत्रम्।।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Grammar",
    "branch": "Vyakarana",
    "keywords": [
      "grammar",
      "vyakarana"
    ]
  },
  {
    "id": "SHLOKA_000037",
    "text": "शून्यं साम्यसमुच्चये।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": []
  },
  {
    "id": "SHLOKA_000038",
    "text": "समीकरणसूत्रम्।।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Grammar",
    "branch": "Vyakarana",
    "keywords": [
      "grammar",
      "vyakarana"
    ]
  },
  {
    "id": "SHLOKA_000039",
    "text": "आनुरूप्येण।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": []
  },
  {
    "id": "SHLOKA_000040",
    "text": "अनुपातसूत्रम्।।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Grammar",
    "branch": "Vyakarana",
    "keywords": [
      "grammar",
      "vyakarana"
    ]
  },
  {
    "id": "SHLOKA_000041",
    "text": "संकलनव्यवकलनाभ्याम्।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": []
  },
  {
    "id": "SHLOKA_000042",
    "text": "परिकलनसूत्रम्।।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Grammar",
    "branch": "Vyakarana",
    "keywords": [
      "grammar",
      "vyakarana"
    ]
  },
  {
    "id": "SHLOKA_000043",
    "text": "पूरणापूरणाभ्याम्।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": []
  },
  {
    "id": "SHLOKA_000044",
    "text": "पूर्णसूत्रम्।।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Grammar",
    "branch": "Vyakarana",
    "keywords": [
      "grammar",
      "vyakarana"
    ]
  },
  {
    "id": "SHLOKA_000045",
    "text": "चलनकलनाभ्याम्।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": []
  },
  {
    "id": "SHLOKA_000046",
    "text": "गतिसूत्रम्।।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Grammar",
    "branch": "Vyakarana",
    "keywords": [
      "grammar",
      "vyakarana"
    ]
  },
  {
    "id": "SHLOKA_000047",
    "text": "यावदूनं तावदूनं।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Unknown",
    "branch": "Unknown",
    "keywords": []
  },
  {
    "id": "SHLOKA_000048",
    "text": "न्यूनतासूत्रम्।।",
    "source": "vedic_mathematics_sutras",
    "chapter": "",
    "veda": "Unknown",
    "domain": "Grammar",
    "branch": "Vyakarana",
    "keywords": [
      "grammar",
      "vyakarana"
    ]
  }
]