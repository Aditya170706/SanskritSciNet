[
  {
    "id": "SHLOKA_000029",
    "text": "एकाधिकेन पूर्वेण।",
    "source": "vedic_mathematics_sutras",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000030",
    "text": "इति सूत्रम्।।",
    "source": "vedic_mathematics_sutras",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000031",
    "text": "निखिलं नवतश्चरमं दशतः।",
    "source": "vedic_mathematics_sutras",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000032",
    "text": "गणितसूत्रम्।।",
    "source": "vedic_mathematics_sutras",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000033",
    "text": "ऊर्ध्वतिर्यग्भ्याम्।",
    "source": "vedic_mathematics_sutras",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000034",
    "text": "वर्गणासूत्रम्।।",
    "source": "vedic_mathematics_sutras",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000035",
    "text": "परावर्त्य योजयेत्।",
    "source": "vedic_mathematics_sutras",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000036",
    "text": "भागसूत्रम्।।",
    "source": "vedic_mathematics_sutras",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000037",
    "text": "शून्यं साम्यसमुच्चये।",
    "source": "vedic_mathematics_sutras",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000038",
    "text": "समीकरणसूत्रम्।।",
    "source": "vedic_mathematics_sutras",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000039",
    "text": "आनुरूप्येण।",
    "source": "vedic_mathematics_sutras",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000040",
    "text": "अनुपातसूत्रम्।।",
    "source": "vedic_mathematics_sutras",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000041",
    "text": "संकलनव्यवकलनाभ्याम्।",
    "source": "vedic_mathematics_sutras",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000042",
    "text": "परिकलनसूत्रम्।।",
    "source": "vedic_mathematics_sutras",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000043",
    "text": "पूरणापूरणाभ्याम्।",
    "source": "vedic_mathematics_sutras",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000044",
    "text": "पूर्णसूत्रम्।।",
    "source": "vedic_mathematics_sutras",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000045",
    "text": "चलनकलनाभ्याम्।",
    "source": "vedic_mathematics_sutras",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000046",
    "text": "गतिसूत्रम्।।",
    "source": "vedic_mathematics_sutras",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000047",
    "text": "यावदूनं तावदूनं।",
    "source": "vedic_mathematics_sutras",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000048",
    "text": "न्यूनतासूत्रम्।।",
    "source": "vedic_mathematics_sutras",
    "chapter": ""
  }
]