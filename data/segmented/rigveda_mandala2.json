[
  {
    "id": "SHLOKA_000018",
    "text": "इन्द्रमिद् गाथिनो बृहदिन्द्रमर्केभिरर्किणः।",
    "source": "rigveda_mandala2",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000019",
    "text": "इन्द्रं वाणीरनूषत।।",
    "source": "rigveda_mandala2",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000020",
    "text": "इन्द्र इद्धर्योः सचा समिश्ल आ वचोयुजा।",
    "source": "rigveda_mandala2",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000021",
    "text": "इन्द्रो वज्री हिरण्ययः।।",
    "source": "rigveda_mandala2",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000022",
    "text": "इन्द्र इद्वृत्रहा वसु दाता मघवा पुरुहूतः।",
    "source": "rigveda_mandala2",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000023",
    "text": "इन्द्रः सोमस्य पीतये।।",
    "source": "rigveda_mandala2",
    "chapter": ""
  }
]