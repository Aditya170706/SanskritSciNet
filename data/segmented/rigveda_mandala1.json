[
  {
    "id": "SHLOKA_000008",
    "text": "अग्निमीळे पुरोहितं यज्ञस्य देवमृत्विजम्।",
    "source": "rigveda_mandala1",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000009",
    "text": "होतारं रत्नधातमम्।।",
    "source": "rigveda_mandala1",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000010",
    "text": "अग्निः पूर्वेभिरृषिभिरीड्यो नूतनैरुत।",
    "source": "rigveda_mandala1",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000011",
    "text": "स देवाँ एह वक्षति।।",
    "source": "rigveda_mandala1",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000012",
    "text": "अग्निना रयिमश्नवत् पोषमेव दिवेदिवे।",
    "source": "rigveda_mandala1",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000013",
    "text": "यशसं वीरवत्तमम्।।",
    "source": "rigveda_mandala1",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000014",
    "text": "अग्ने यं यज्ञमध्वरं विश्वतः परिभूरसि।",
    "source": "rigveda_mandala1",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000015",
    "text": "स इद्देवेषु गच्छति।।",
    "source": "rigveda_mandala1",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000016",
    "text": "अग्निर्होता कविक्रतुः सत्यश्चित्रश्रवस्तमः।",
    "source": "rigveda_mandala1",
    "chapter": ""
  },
  {
    "id": "SHLOKA_000017",
    "text": "देवो देवेभिरागमत्।।",
    "source": "rigveda_mandala1",
    "chapter": ""
  }
]